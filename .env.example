# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app-name.herokuapp.com,www.yourdomain.com

# Database (Heroku will provide this automatically)
DATABASE_URL=postgres://user:password@host:port/database

# Cloudinary Settings (for media files)
# Sign up at https://cloudinary.com and get your credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sentry Error Tracking (optional but recommended)
# Sign up at https://sentry.io and create a new Django project
# Get your DSN from Project Settings > Client Keys (DSN)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# Optional: For local development
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
