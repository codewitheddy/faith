# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://jewellery_user:strong_password_here@localhost:5432/jewellery_db
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Cloudinary Configuration (for image storage)
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to Git (it's in .gitignore)
# 3. Generate a new SECRET_KEY for production using:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Set DEBUG=False in production
# 5. Update ALLOWED_HOSTS with your actual domain(s)
# 6. PostgreSQL is recommended for production (better performance and features than MySQL)
